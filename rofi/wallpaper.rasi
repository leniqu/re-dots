* {
    background-color: rgba(0, 0, 0, 0.85);
    border-radius: 20px;
    font: "JetBrainsMono Nerd Font 14";
    text-color: #ffffff;
}

window {
    width: 500px;
    background-color: rgba(0, 0, 0, 0.85);
    border-radius: 20px;
}

inputbar {
    enabled: false;
}

element {
    padding: 10px;
    background-color: rgba(0, 0, 0, 0);
    text-color: #ffffff;
}

element selected {
    background-color: rgba(255, 255, 255, 0.15);
}

element-icon {
    size: 24px;
}
