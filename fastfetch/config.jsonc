{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "auto",
    "color": {
      "1": "white",
      "2": "white",
      "3": "white",
      "4": "white",
      "5": "white",
      "6": "white",
      "7": "white",
      "8": "white",
      "9": "white"
    },
    "padding": {
      "top": 1,
      "right": 2
    }
  },
  "display": {
    "separator": " ➜  ",
    "color": {
      "keys": "white",
      "title": "white",
      "output": "white",
      "separator": "white"
    },
    "key": {
      "width": 10
    }
  },
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "font", 
    "display",
    "de",
    "wm",
    "terminal",
    "cpu",
    "gpu",
    "memory",
    "break",
    "colors"
  ]
}

