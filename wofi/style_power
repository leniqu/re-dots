window {
    background-color: rgba(0, 0, 0, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 20px;
}

#outer-box {
    margin: 10px;
    background-color: transparent;
}

#entry {
    padding: 15px;
    margin: 5px;
    border-radius: 12px;
}

#entry:selected {
    background-color: rgba(255, 255, 255, 0.1);
}

/* Общий стиль для текста и иконок */
#text {
    font-family: "Rubik", "JetBrainsMono Nerd Font";
    color: #ffffff;
    /* Убираем жесткий margin-left, чтобы он не ломал текст Wi-Fi */
    margin: 0px; 
}

/* МАГИЯ: если текст короткий (как наши иконки в меню выключения) */
/* Мы используем центровку, которая не ломает длинные строки Wi-Fi */
#text {
    horizontal-align: 0.5;
}

/* Скрываем ввод полностью */
#input, #prompt {
    all: unset;
}
