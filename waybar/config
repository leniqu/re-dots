{
    "layer": "top",
    "position": "top",
    "height": 38,
    "margin-top": 8,
    "margin-left": 15,
    "margin-right": 15,
    "spacing": 0,

    "modules-left": ["clock"],
    "modules-center": ["hyprland/workspaces"],
"modules-right": [
    "network", 
    "hyprland/language", 
    "custom/wallpaper", // Теперь он здесь (справа от раскладки)
    "pulseaudio",        // И слева от звука
    "custom/powermenu"
],

    "hyprland/workspaces": {
        "format": "{name}",
        "on-click": "activate",
        "persistent-workspaces": {
            "*": 5
        }
    },

    "clock": {
        "format": "{:%H:%M}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },

    "hyprland/language": {
        "format": "{}",
        "format-en": "EN",
        "format-ru": "RU"
    },

    "network": {
        "format-wifi": "",
        "format-ethernet": "  ",
        "format-disconnected": "  ",
        "on-click": "bash ~/.config/waybar/wifi.sh",
        "tooltip-format": "{essid}"
    },

    "pulseaudio": {
        "format": "{icon}  {volume}%",
        "format-muted": "Muted",
        "format-icons": {
            "default": ["", "", ""]
        },
        "on-click": "pavucontrol"
    },

"custom/wallpaper": {
    "format": " ",
    "on-click": "~/.config/hypr/scripts/wallselect.sh",
    "on-click-right": "waypaper --random",
    "tooltip": false
},

    "custom/powermenu": {
        "format": "",
        "on-click": "bash ~/.config/rofi/powermenu.sh",
        "tooltip": false
    }
}
