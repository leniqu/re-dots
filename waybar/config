{
    "layer": "top",
    "position": "bottom",
    "height": 38,
    "margin-top": 5,
    "margin-left": 5,
    "margin-right": 5,
    "spacing": 0,

    "modules-left": ["clock", "custom/notifications", "custom/player"],
    "modules-center": ["hyprland/workspaces"],
    "modules-right": [
        "network", 
        "hyprland/language", 
        "custom/wallpaper",
        "pulseaudio",
        "custom/powermenu"
    ],

    "hyprland/workspaces": {
        "format": "{name}",
        "on-click": "activate",
        "persistent-workspaces": {
            "*": 5
        }
    },

    "clock": {
        "format": "{:%H:%M}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },

    "hyprland/language": {
        "format": "{}",
        "format-en": "EN",
        "format-ru": "RU"
    },

    "network": {
        "format-wifi": "",
        "format-ethernet": "  ",
        "format-disconnected": "  ",
        "on-click": "bash ~/.config/waybar/wifi.sh",
        "tooltip-format": "{essid}"
    },

    "pulseaudio": {
        "format": "{icon}  {volume}%",
        "format-muted": "Muted",
        "format-icons": {
            "default": ["", "", ""]
        },
        "on-click": "pavucontrol"
    },

    "custom/wallpaper": {
        "format": " ",
        "on-click": "~/.config/hypr/scripts/wallselect.sh",
        "on-click-right": "waypaper --random",
        "tooltip": false
    },

    "custom/powermenu": {
        "format": "",
        "on-click": "bash ~/.config/rofi/powermenu.sh",
        "tooltip": false
    },

    "custom/notifications": {
        "tooltip": false,
        "format": "{icon} ",
        "format-icons": {
            "notification": "",
            "none": "",
            "dnd-notification": "",
            "dnd-none": "",
            "inhibited-notification": "",
            "inhibited-none": "",
            "dnd-inhibited-notification": "",
            "dnd-inhibited-none": ""
        },
        "return-type": "json",
        "exec-if": "which swaync-client",
        "exec": "swaync-client -swb",
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw",
        "escape": true
    },
"custom/player": {
    "format": " ",
    "on-click": "~/.config/eww/player.sh",
    "tooltip": false
},
}
